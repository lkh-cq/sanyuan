# sanyuan sidecar 环境配置 (对接 Hermes obsidian-memory MCP 的 SQLite)
# 启动: source /mnt/d/sanyuan-skills/integrations/obsidian/python/.venv/bin/activate
#        && python -m sanyuan_obsidian serve --db /mnt/d/hermes_memory/maintenance/obsidian-memory.db --port 8765

# 数据库 (Hermes obsidian-memory MCP 的索引)
SANYUAN_OBSIDIAN_DB=/mnt/d/hermes_memory/maintenance/obsidian-memory.db

# Embedding (SiliconFlow, 已验证 bge-large-zh-v1.5 1024维)
SANYUAN_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
SANYUAN_EMBEDDING_API_KEY=
SANYUAN_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
SANYUAN_EMBEDDING_TIMEOUT=30

# sidecar token (可选, 插件端配置同样的)
# SANYUAN_SIDECAR_TOKEN=

# SiliconFlow rerank (BAAI/bge-reranker-v2-m3)
SANYUAN_RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
SANYUAN_RERANK_API_KEY=
SANYUAN_RERANK_MODEL=BAAI/bge-reranker-v2-m3
