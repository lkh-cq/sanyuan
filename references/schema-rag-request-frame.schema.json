{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "RAGRequestFrame",
  "description": "Front-end output contract. Sanyuan compiles query, source references and advisory attention hints; retrieval, reranking and generation remain external.",
  "type": "object",
  "required": [
    "request_id",
    "task_id",
    "boundary_ref",
    "primary_query",
    "source_refs",
    "attention_hints",
    "filter"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^ragreq_[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "boundary_ref": {
      "type": "string",
      "minLength": 1
    },
    "primary_query": {
      "type": "string",
      "minLength": 1
    },
    "secondary_axes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normalization_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "attention_hints": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {
          "const": "advisory_only"
        },
        "rho": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "theta": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "primary_axes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "secondary_axes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "routing_metadata_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "filter": {
      "type": "object",
      "required": ["filter_applied"],
      "properties": {
        "filter_applied": {"type": "boolean"},
        "lease_ref": {"type": ["string", "null"]},
        "receipt_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
