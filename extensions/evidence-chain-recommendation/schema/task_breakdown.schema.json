{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecr.task_breakdown/v1",
  "title": "ECR 输入 · 命题分解与候选池",
  "type": "object",
  "required": ["schema", "task", "budget", "evidence"],
  "properties": {
    "schema": {"const": "ecr.task_breakdown/v1"},
    "instance_id": {"type": "string"},
    "produced_by": {"type": "string"},
    "task": {
      "type": "object",
      "required": ["x_id", "statement", "subquestions"],
      "properties": {
        "x_id": {"type": "string"},
        "statement": {"type": "string", "description": "命题原文，禁止为可算而改写"},
        "subquestions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "resolution"],
            "properties": {
              "id": {"type": "string", "pattern": "^x[0-9]+$"},
              "text": {"type": "string"},
              "type": {"enum": ["exist", "direction", "magnitude", "mechanism"]},
              "resolution": {"enum": ["locked", "free"]},
              "critical": {"type": "boolean", "default": false}
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["B"],
      "properties": {
        "B": {"type": "integer", "exclusiveMinimum": 0},
        "lambda_exclusive": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.3}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "ecr.evidence_unit/v1"}}
  }
}
